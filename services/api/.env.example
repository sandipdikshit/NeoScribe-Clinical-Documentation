# App Configs
# The host and port where the application will run
APP_HOST = "127.0.0.1"
APP_PORT = 5000
MONITORING_ENABLED = false
CORS_ORIGINS = "http://localhost:3000"

# Azure Language Service
# Replace with your Azure Language service key and endpoint
AZURE_LANGUAGE_KEY = "your_azure_language_key"
AZURE_LANGUAGE_ENDPOINT = "https://your-language-service.cognitiveservices.azure.com/"

# Azure Speech Service
# Replace with your Azure Speech service subscription key and region
SPEECH_SUBSCRIPTION_KEY = "your_speech_subscription_key"
SPEECH_SERVICE_REGION = "your_service_region"

# Large Language Model (LLM)
# Replace with your LLM API URL and API key
LLM_API_URL = "https://your-llm-api-url/v1/completions"
LLM_API_KEY = "your_llm_api_key"

# Database
# Replace with your database connection URL
DATABASE_URL = "postgresql://username:password@localhost:5432/database_name"

# Azure Storage
# Replace with your Azure Storage account details
AZURE_STORAGE_ACCOUNT_NAME = "your_storage_account_name"
AZURE_STORAGE_ACCOUNT_KEY = "your_storage_account_key"
AZURE_STORAGE_CONTAINER_NAME = "your_storage_container_name"

# Azure Storage Connection String
# Replace with your Azure Storage connection string
AZURE_STORAGE_CONNECTION_STRING = "your_storage_connection_string"

# SAS URL
# Replace with your SAS URL for accessing Azure Storage
SAS_URL = "https://your_storage_account.blob.core.windows.net/your_container/your_file?sp=r&st=2024-11-08T19:09:42Z&se=2024-11-09T03:09:42Z&spr=https&sv=2022-11-02&sr=b&sig=your_sas_token"
