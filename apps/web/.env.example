# Web app
NEXT_PUBLIC_APP_NAME="NeoScribe"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NeoScribe API
NEXT_PUBLIC_API_BASE_URL="http://localhost:5000/api"
NEXT_PUBLIC_API_VERSION="v2"
NEXT_PUBLIC_WS_URL="ws://localhost:5000/socket/transcribe/ws"

# Provider authentication service
NEXT_PUBLIC_AUTH_BASE_URL="http://localhost:3001/api/authentication"
NEXT_PUBLIC_AUTH_VERSION="v1"

# This value is available in the browser. Use a development-only value locally.
NEXT_PUBLIC_AES_SECRET_KEY="replace-with-a-development-value"
